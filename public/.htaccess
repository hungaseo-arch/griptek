# CV GRIPTEK Solusi — Apache(공유 호스팅) 라우팅
# prerender 된 카테고리 라우트는 정적 HTML 로 직접 제공하고,
# 그 외(/biz 등)는 SPA 엔트리(index.html)로 폴백해 vue-router 가 처리한다.

# ── Biz Form (직원 전용) — HTTP Basic 인증 ──────────────────────────────────
# /biz 및 그 하위 경로 요청에만 인증 요구. 인증 단계는 rewrite(폴백)보다 먼저 평가됨.
# AuthUserFile = cPanel 홈(/home/gria4449)의 .htpasswd-biz (직접 생성·업로드, docs 참고).
# .ht* 파일은 Apache 가 웹 접근 자동 차단.
<If "%{REQUEST_URI} =~ m#^/biz(/|$)#">
  AuthType Basic
  AuthName "Biz Form - Staff Only"
  AuthUserFile "/home/gria4449/.htpasswd-biz"
  Require valid-user
</If>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 트레일링 슬래시 301(no-slash → slash) 방지 → canonical(/ban-forklift) 과 일치
  DirectorySlash Off
  Options -MultiViews

  # 1) prerender 라우트: 요청 경로에 대응하는 index.html 이 있으면 그대로 제공.
  #    단일(/ban-otr) · 중첩(/ban-otr/23-5r25) 경로 모두 처리, 리다이렉트 없음.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # 2) 실제 파일/디렉터리(assets, sitemap.xml, robots.txt 등)는 그대로 제공
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) 그 외 모든 경로 → SPA 엔트리(클라이언트 라우팅)
  RewriteRule ^ /index.html [L]
</IfModule>

# 정적 자산 캐시 (해시 파일명이라 장기 캐시 안전)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>
