    "predeploy": "npm run build",
    "deploy": "node --env-file=.env deploy.js"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "basic-ftp": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vue-tsc": "^2.1.10"
  }
}
