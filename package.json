{
  "name": "griptek-business-forms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CV GRIPTEK Solusi — Business Document Forms",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
