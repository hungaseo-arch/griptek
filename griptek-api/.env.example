# cPanel File Manager 로 .env 직접 작성 (이 예시 복사). 절대 커밋 금지.
DB_HOST=localhost
DB_USER=griptek_user
DB_NAME=griptek_shop
DB_PASS=__db_password__

JWT_SECRET=__random_64_chars__
# 프론트 도메인 (CORS). 여러 개면 콤마로 구분.
CORS_ORIGIN=https://gripteksolusi.com
# cPanel Node.js App 은 보통 8080 (LISTEN 포트는 Passenger 가 주입하기도 함)
PORT=8080
